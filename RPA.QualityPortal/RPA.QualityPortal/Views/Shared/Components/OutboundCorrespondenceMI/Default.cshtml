@model RPA.QualityPortal.ViewModels.OutboundCorrespondenceVM.MI.OutboundCorrespondenceMI


@using (Html.BeginForm("MIIndex", "OutboundCorrespondenceMI", new { back = false }, FormMethod.Post))
{
    <div class="form-inline" style="margin-bottom:30px;">

        @if ((User.IsInRole("Quality Checks: OC Admin")) || (User.IsInRole("Quality Checks: OC Team Manager")))
        {
            <div class="form-group">
                <input type="text" class="form-control" id="searchString" name="searchString" style="width:200px" disabled="disabled" placeholder="Type Name Here" />
            </div>
            <div class="form-group" id="scheme" style="display:none">
                @Html.DropDownList("SchemeId", null, "", htmlAttributes: new { @class = "form-control" })
            </div>
            <div class="form-group" id="business" style="display:none">
                @Html.DropDownList("BusinessAreaId", null, "", htmlAttributes: new { @class = "form-control" })
            </div>
            <div class="form-group" id="correspondence" style="display:none">
                @Html.DropDownList("CorrespondenceTypeId", null, "", htmlAttributes: new { @class = "form-control" })
            </div>

            <select class="form-control" style="width:200px; font-size:15px;" id="searchOption" name="searchOption">
                <option value="empty" selected disabled>Search Option</option>
                <option value="QCName">QC Name</option>
                <option value="LineManager">Line Manager</option>
                <option value="HEO">HEO</option>
                <option value="SEO">SEO</option>
                <option value="QCChecker">Quality Checker</option>
                <option value="Scheme">Scheme</option>
                <option value="BusinessArea">Business Area</option>
                <option value="CorrespondenceType">Correspondence Type</option>

            </select>
        }
            <div class="btn-group">
                <button type="submit" class=" btn btn-success" value="search" name="btnIndexFilter">Search</button>
                <button type="submit" class=" btn btn-danger" value="reset" name="btnIndexReset">Reset</button>
            </div>

        <div>
            <h5>Date Range: </h5>

        </div>

        <div>
            <input type="text" class="date-picker form-control date-input" typeof="datetime" id="from" name="DateFrom" inputmode="none" style="width:200px; background:white;" placeholder="From" ; />
            <input type="text" class="date-picker form-control date-input" typeof="datetime" id="to" name="DateTo" inputmode="none" style="width:200px;  background:white" placeholder="To" ; />
        </div>
        <p><i>Leave both dates blank to search all records</i></p>

    </div>

}



@if (ViewBag.Search == "Search")
{
    <h3>@Model.SearchType</h3>

    if (Model.DateFrom != null && Model.DateTo != null)
    {
        <h4>From: @Model.DateFrom.Value.ToShortDateString()  To: @Model.DateTo.Value.ToShortDateString() </h4>
    }
    else if (Model.DateFrom != null)
    {
        <h4>From: @Model.DateFrom.Value.ToShortDateString() To: Current Date</h4>
    }
    else if (Model.DateTo != null)
    {
        <h4>All Records To: @Model.DateTo.Value.ToShortDateString() </h4>
    }



}

<h3>QC MI Overview</h3>

<div class="form-horizontal">
    <div class="panel panel-primary">

        @if (Model.ResultHeader != null)
        {
            if (Model.ResultHeader != "Individual")
            {
                <div class="panel-heading">Quality Check MI Overview for @Model.ResultHeader</div>
            }
            else
            {
                <div class="panel-heading">Quality Check MI Overview for @Model.SearchType.Remove(0,9)</div>
            }
        }
        else
        {
            <div class="panel-heading">Quality Check MI Overview</div>
        }
