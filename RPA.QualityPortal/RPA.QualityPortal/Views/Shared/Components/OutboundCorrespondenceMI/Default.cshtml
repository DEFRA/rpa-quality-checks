</div>

<script>

    $(function () {
        $(".date-picker").datepicker({
            dateFormat: 'dd/M/yy',
            todayBtn: true,
            autoclose: true
        });
    });

    //function to enable search string field once option selected
    $(function(){
        $('#searchOption').on('change', function () {

            $("#scheme").hide();
            $("#business").hide();
            $('#correspondence').hide();
            $('#searchString').show();

            if (this.value == "Scheme") {
                $("#scheme").show();
                $('#searchString').hide();
            }
            else if (this.value == "BusinessArea") {
                $("#business").show();
                $('#searchString').hide();
            }
            else if (this.value == "CorrespondenceType") {
                $('#correspondence').show();
                $('#searchString').hide();
            }
            else {
                $('#searchString').attr('disabled', false);
            }

        });
    });

    $(function () {

    //lookup for Name

        $('#searchString').on('keyup change', function () {

            var fieldName = '#searchString';
            var idName = '#NameId'

            personChecker(fieldName, idName);

        });

            //function to lookup people in people data

    function personChecker(fieldName, idName) {

        $(fieldName).autocomplete({
            source: function (request, response) {
                $.ajax({
                    dataType: 'json',
                    type: 'Get',
                    url: '@Url.Action("PeopleSearch", "People")',
                    data: { searchstring: request.term },

                    success: function (data) {
                        response($.map(data, function (item) {
                            return item

                            })
                        );
                    }
                })
            },

            select: function (event, ui) {
                $(fieldName).val(ui.item.label);
                $(idName).val(ui.item.value);
                return false;
            },
                minLength: 1,
            })

        }

     })

</script>