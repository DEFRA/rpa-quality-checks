                    <th>@Html.DisplayNameFor(model => model.OutboundCorrespondenceMIStats.PassedAdvisoryPercentage)</th>
                    <th>@Html.DisplayNameFor(model => model.OutboundCorrespondenceMIStats.Failed)</th>
                    <th>@Html.DisplayNameFor(model => model.OutboundCorrespondenceMIStats.FailedPercentage)</th>
                    <th>@Html.DisplayNameFor(model => model.OutboundCorrespondenceMIStats.ReChecksRequired)</th>
                    <th>@Html.DisplayNameFor(model => model.OutboundCorrespondenceMIStats.ReChecksNotRequired)</th>
                </tr>

                <tr>
                    <td>@Html.DisplayFor(model => model.OutboundCorrespondenceMIStats.TotalQcs)</td>
                    <td>@Html.DisplayFor(model => model.OutboundCorrespondenceMIStats.Passed)</td>
                    <td>@Html.DisplayFor(model => model.OutboundCorrespondenceMIStats.PassedPercentage)</td>
                    <td>@Html.DisplayFor(model => model.OutboundCorrespondenceMIStats.PassAdvisory)</td>
                    <td>@Html.DisplayFor(model => model.OutboundCorrespondenceMIStats.PassedAdvisoryPercentage)</td>
                    <td>@Html.DisplayFor(model => model.OutboundCorrespondenceMIStats.Failed)</td>
                    <td>@Html.DisplayFor(model => model.OutboundCorrespondenceMIStats.FailedPercentage)</td>
                    <td>@Html.DisplayFor(model => model.OutboundCorrespondenceMIStats.ReChecksRequired)</td>
