@model RPA.QualityPortal.Models.Challenge

<div class="form-horizontal">
    <div class="panel panel-primary">
        <div class="panel-heading">Challenge Details</div>
        <div class="panel-body">

            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.ChallengeOutcome.Text)
                </span>
                <div class="col-md-10" style="padding-top:6px; padding-left:15px">
                    @Model.ChallengeOutcome.Text
                    @Html.ValidationMessageFor(model => model.ChallengeOutcomeId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.ChallengeDate)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.ChallengeDate, "{0:dd/MM/yyyy}", htmlAttributes: new { @readonly = "readonly", @disabled = "disabled", @type = "datetime", @class = "form-control form-control-length" })
                </div>
            </div>
        </div>
    </div>
</div>