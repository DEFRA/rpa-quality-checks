@model RPA.QualityPortal.ViewModels.OutboundCorrespondenceVM.MI.OutboundCorrespondenceMIDetails


@{
    ViewBag.Title = "MIDetails";
    ViewBag.CheckType = "Outbound";
}

<div class="jumbotron">
    <h1>Outbound Correspondence QC Details</h1>
    <p>Quality Checking for Outbound Correspondence MI - Individual Details</p>
</div>

@if (!String.IsNullOrEmpty(Model.SearchType))
{
    <h3>QC MI Details for @ViewBag.PersonName</h3>

    if (Model.DateFrom != null && Model.DateTo != null)
    {
        <h4>From: @Model.DateFrom.Value.ToShortDateString()  To: @Model.DateTo.Value.ToShortDateString() </h4>
    }
    else if (Model.DateFrom != null)
    {
        <h4>From: @Model.DateFrom.Value.ToShortDateString() To: Current Date</h4>
    }
    else if (Model.DateTo != null)
    {
        <h4>All Records To: @Model.DateTo.Value.ToShortDateString() </h4>
    }
}


<div class="form-horizontal">
    <div class="panel panel-primary">
        @if (Model.ResultHeader != null)
        {


            if (Model.SearchType.Substring(0, 3) == "SEO")
            {
                <div class="panel-heading">QC Failure Details Breakdown for HEO's under @ViewBag.PersonName </div>
            }
            else if (Model.SearchType.Substring(0, 3) == "HEO")
            {
                <div class="panel-heading">QC Failure Details Breakdown for Line Managers under @ViewBag.PersonName </div>
            }
            else
            {
                <div class="panel-heading">QC Failure Details for @ViewBag.PersonName </div>
            }
        }
        else
        {
            <div class="panel-heading">QC Failure Details</div>
        }
        <div class="panel-body">
            <table class="table table-condensed table-striped">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Failed)</th>
                    <th>@Html.DisplayNameFor(model => model.FailedPercentage) </th>
                </tr>

                <tr>
                    <td>@Html.DisplayFor(model => model.Failed)</td>
                    <td>@Html.DisplayFor(model => model.FailedPercentage)</td>
                </tr>
            </table>
        </div>
    </div>
    <div class="panel panel-primary">
        @if (Model.ResultHeader != null)
        {


            if (Model.SearchType.Substring(0, 3) == "SEO")
            {
                <div class="panel-heading">QC Failure Details Breakdown for HEO's under @ViewBag.PersonName </div>
            }
            else if (Model.SearchType.Substring(0, 3) == "HEO")
            {
                <div class="panel-heading">QC Failure Details Breakdown for Line Managers under @ViewBag.PersonName </div>
            }
            else
            {
                <div class="panel-heading">QC Failure Details Breakdown for @ViewBag.PersonName</div>
            }
        }
        else
        {
            <div class="panel-heading">QC Failure Details Breakdown</div>
        }
        <div class="panel-body">
            <table class="table table-condensed table-striped">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.FailReasonCount[0].FailReason)</th>
                    <th>@Html.DisplayNameFor(model => model.FailReasonCount[0].FailedNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.FailReasonCount[0].FailedPercentage)</th>
                </tr>
                @foreach (var item in Model.FailReasonCount)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.FailReason)</td>
                        <td>@Html.DisplayFor(modelItem => item.FailedNumber)</td>
                        <td>@Html.DisplayFor(modelItem => item.FailedPercentage)</td>
                    </tr>
                }
            </table>
        </div>

    </div>

</div>

@if (Model.ResultHeader == "Individual")
{
    <div class="form-horizontal">
        <div class="panel panel-primary">
            <div class="panel-heading">Answer MI breakdown for @ViewBag.PersonName </div>
            <table class="table">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.AnswerMIStats[0].Question.Text)
                    </th>

                    <th>
                        @Html.DisplayNameFor(model => model.AnswerMIStats[0].AnswerYes)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AnswerMIStats[0].AnswerYesPercent)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AnswerMIStats[0].AnswerNo)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AnswerMIStats[0].AnswerNoPercent)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AnswerMIStats[0].AnswerNA)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.AnswerMIStats[0].AnswerNAPercent)
                    </th>
                </tr>

                @foreach (var item in Model.AnswerMIStats)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Question.Text)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AnswerYes)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AnswerYesPercent)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AnswerNo)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AnswerNoPercent)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AnswerNA)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AnswerNAPercent)
                        </td>
                    </tr>
                }
            </table>
        </div>

    </div>
}


    @if (ViewBag.Page == "MIDetailsOverview")
    {
        <div class="form-group">
            <a href="@Url.Action("MIDetails","OutboundCorrespondenceMI", new { back = true})" class="link-back">Back</a>
        </div>
    }
    else if (ViewBag.Page == "MIDetailsIndividual")
    {
        <div class="form-group">
            <a href="@Url.Action("MIIndex","OutboundCorrespondenceMI", new { back = true})" class="link-back">Back</a>
        </div>
    }