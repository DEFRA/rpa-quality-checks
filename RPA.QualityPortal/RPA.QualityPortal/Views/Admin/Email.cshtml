@if (ViewBag.typeOfCheck == "OutboundCorrespondence")
{
    {
        ViewBag.Title = "Index";
        ViewBag.CheckType = "Outbound";
    }
}
else if (ViewBag.typeOfCheck == "Bank")
{
    {
        ViewBag.Title = "Index";
        ViewBag.CheckType = "BankAccount";
    }
}

@using X.PagedList;
@using X.PagedList.Mvc.Core;

<div class="jumbotron">
    <h1>Email Administration</h1>
    <p>Switching the auto sending of noifications of emails on and off</p>
</div>

<div>
    @await Component.InvokeAsync("TurnOffEmail", new { checkType = ViewBag.typeOfCheck })<br />
</div>

@if (ViewBag.typeOfCheck == "OutboundCorrespondence")
{
    <div>
        @await Component.InvokeAsync("OutboundCorrespondenceEmails")
    </div>

    <div>
        @await Component.InvokeAsync("ReCheckEmails")
    </div>
}
else if (ViewBag.typeOfCheck == "Bank")
{
    <div>
        @await Component.InvokeAsync("BankEmails")
    </div>

    <div>
        @await Component.InvokeAsync("BankReCheckEmails")
    </div>
}


