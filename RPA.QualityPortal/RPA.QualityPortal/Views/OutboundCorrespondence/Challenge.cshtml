@model RPA.QualityPortal.Models.Challenge

@{
    ViewBag.CheckType = "Outbound";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<div class="jumbotron">
    <h1>Outbound Correspondence Quality Check</h1>
    <h3>Challenge</h3>
</div>

@using (Html.BeginForm("Challenge", "OutboundCorrespondence", new { ReCheck = ViewBag.ReCheck }, FormMethod.Post))
{
    @Html.AntiForgeryToken()


    @Html.HiddenFor(x => x.CheckId)

    <div class="form-horizontal">
        <div class="panel panel-primary">
            <div class="panel-heading">Challenge Details</div>
            <div class="panel-body">
                <div class="form-group">
                    <span class="control-label col-md-2"><b>QC Result</b></span>

                    <div class="col-md-10" style="padding-top:6px; padding-left:15px">@ViewBag.QCResult</div>
                </div>
                <div class="form-group">
                    <span class="control-label col-md-2"><b>ReCheck Required</b></span>

                    <div class="col-md-10" style="padding-top:6px; padding-left:15px">@ViewBag.ReCheck</div>
                </div>

                <div class="form-group">
                    <span class="control-label col-md-2">@Html.LabelFor(model => model.ChallengeOutcome.Text)</span>
                    <div class="col-md-10">
                        @Html.DropDownList("ChallengeOutcomeId", null, "", htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.ChallengeOutcomeId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <span class="control-label col-md-2">@Html.LabelFor(model => model.ChallengeDate)</span>
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.ChallengeDate, "{0:dd/MM/yyyy}", htmlAttributes: new { @Value = "  " + @DateTime.Now.ToString("dd/MMMM/yyyy"), @readonly = "readonly", @disabled = "disabled", @type = "datetime", @class = "form-control form-control-length" })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-group">
        <input type="submit" value="Continue" class="button" />
    </div>
}

<div class="form-group">
    @Html.ActionLink("Cancel", "Details", "OutboundCorrespondence", new { CheckId = Model.CheckId }, null)
</div>