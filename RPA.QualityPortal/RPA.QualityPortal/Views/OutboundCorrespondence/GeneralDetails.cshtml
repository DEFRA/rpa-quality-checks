@model RPA.QualityPortal.Models.CheckTypes.OutboundCorrespondence

@{
    ViewBag.Title = "Details";
    ViewBag.CheckType = "Outbound";
}

<h2>Details</h2>

<div class="form-horizontal">
    <div class="panel panel-primary">
        <div class="panel-heading">Quality Check Details - Outbound Correspondence</div>
        <div class="panel-body">

            @Html.HiddenFor(model => model.CheckId)

            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.Scheme.Text)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.Scheme.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>

            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.BusinessArea.Text)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.BusinessArea.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>

            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.CorrespondenceType.Text)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.CorrespondenceType.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>

            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.TemplateReference)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.TemplateReference, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>

            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.UniqueId)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.UniqueIdentifierPrefix.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                    @Html.TextBoxFor(model => model.UniqueId, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>

            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.CRMRef)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.CRMRefPrefix.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                    @Html.TextBoxFor(model => model.CRMRef, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
