                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.DateQCCompleted)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.DateQCCompleted, "{0:dd/MM/yyyy}", htmlAttributes: new { @class = "form-control", @readonly = "readonly", @disabled = "disabled", @type = "datetime", @style = "width:300px; font-size:15px;" })
                </div>
            </div>

        </div>
    </div>
</div>
<p>
    @Html.ActionLink(linkText: "Recheck", actionName: "CreateReCheckQuestions", controllerName: "OutboundCorrespondenceReCheck", routeValues: new { CheckId = Model.CheckId }, htmlAttributes: null) |
    <a href="@Url.Action("Index","OutboundCorrespondence")" class="link-back">Back</a>
</p>