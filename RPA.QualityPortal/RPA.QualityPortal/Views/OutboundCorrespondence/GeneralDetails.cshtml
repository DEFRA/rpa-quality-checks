                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.HEO, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>

            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.SEO)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.SEO, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
