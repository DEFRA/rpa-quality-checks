@model RPA.QualityPortal.Models.CheckTypes.OutboundCorrespondence

@{
    ViewBag.CheckType = "Outbound";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="jumbotron">
    <h1>Complete Quality Check</h1>
    <h3>Complete Outbound Correspondence Check</h3>
</div>

@using (Html.BeginForm("CreateResult", "OutboundCorrespondence", FormMethod.Post, new { @id = "CreateResult" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(x => x.CheckId)
    @Html.HiddenFor(model => model.TemplateReference)
    @Html.HiddenFor(model => model.SBI)
    @Html.HiddenFor(model => model.CRMRef)
    @Html.HiddenFor(model => model.ManagerName)
    @Html.HiddenFor(model => model.HEO)
    @Html.HiddenFor(model => model.SEO)
    @Html.HiddenFor(model => model.PersonName)
    @Html.HiddenFor(model => model.QCCompletedByName)
    @Html.HiddenFor(model => model.UniqueId)


    <div class="form-horizontal">
        <div class="panel panel-primary">
            <div class="panel-heading">Outbound Correspondence - QC Result</div>
            <div class="panel-body">

                <div class="form-group">
                    <span class="control-label col-md-2"><b>QC Result</b></span>

                    <div class="col-md-10" style="padding-top:6px; padding-left:15px">@ViewBag.QCResult</div>
                </div>

                @if (ViewBag.QCResult == "Not Approved")
                {
                    <div class="form-group">
                        <span class="control-label col-md-2">@Html.LabelFor(model => model.FailReason.Text, htmlAttributes: new { @class = "form-label" })</span>
                        <div class="col-md-10">
                            @Html.DropDownList("FailReasonID", null, "", htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.FailReasonId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <span class="control-label col-md-2">@Html.LabelFor(model => model.ReCheckRequired, htmlAttributes: new { @class = "form-label" })</span>
                        <div class="col-md-10">
                            <div class="multiple-choice">
                                @Html.RadioButtonFor(model => model.ReCheckRequired, "True", htmlAttributes: new { @checked = "true", @name = "ReCheckFailTrue" })@Html.Label("Yes")
                            </div>
                            <div class="multiple-choice">
                                @Html.RadioButtonFor(model => model.ReCheckRequired, "False", htmlAttributes: new { @name = "ReCheckFailFalse" })@Html.Label("No")
                            </div>
                        </div>
                    </div>
                }

                <div class="form-group">

                    <span class="control-label col-md-2">@Html.LabelFor(model => model.ExcludeQCResult, htmlAttributes: new { @class = "form-label" })</span>
                    <div class="col-md-10">
                        <div class="multiple-choice">
                            @Html.RadioButtonFor(model => model.ExcludeQCResult, "True", htmlAttributes: new { @name = "ExcludeQCTrue" })@Html.Label("Yes")
                        </div>
                        <div class="multiple-choice">
                            @Html.RadioButtonFor(model => model.ExcludeQCResult, "False", htmlAttributes: new { @name = "ExcludeQCFalse" })@Html.Label("No")
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <span class="control-label col-md-2">@Html.LabelFor(model => model.Comments, htmlAttributes: new { @class = "form-label" })</span>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.Comments, new { @class = "form-control", rows = 6 })
                        @Html.ValidationMessageFor(model => model.Comments, "", new { @class = "text-danger" })
                    </div>
                </div>

                @if (ViewBag.Email == true)
                {
                    <div class="form-group">

                        <span class="control-label col-md-2">@Html.LabelFor(model => model.EmailNotifications, htmlAttributes: new { @class = "form-label" })</span>
                        <div class="col-md-10">
                            <div class="multiple-choice">
                                @Html.RadioButtonFor(model => model.EmailNotifications, "True", htmlAttributes: new { @name = "EmailSendYes", @checked = "checked" })@Html.Label("Yes")
                            </div>
                            <div class="multiple-choice">
                                @Html.RadioButtonFor(model => model.EmailNotifications, "False", htmlAttributes: new { @name = "EmailSendNo" })@Html.Label("No")
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-group">

                        <span class="control-label col-md-2">@Html.LabelFor(model => model.EmailNotifications, htmlAttributes: new { @class = "form-label" })</span>
                        <div class="col-md-10">
                            <div style="padding-top:7px">Email Notifications are switched off</div>
                        </div>
                    </div>
                }


            </div>
        </div>


    </div>
    <div class="form-group">
        <input type="submit" value="Save and Submit Quality Check" class="button" />
    </div>


}
<div class="form-group">
    <a href="@Url.Action("CreateQuestions","OutboundCorrespondence")" class="link-back">Back</a>
</div>
