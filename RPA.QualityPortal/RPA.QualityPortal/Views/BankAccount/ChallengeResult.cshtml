@model RPA.QualityPortal.Models.CheckTypes.BankAccountCheck

@{
    ViewBag.CheckType = "BankAccount";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

    <div class="jumbotron">
        <h1>Bank Account QC</h1>
        <h3>Complete a Bank Account Check</h3>
    </div>

@using (Html.BeginForm("ChallengeResult", "BankAccount", FormMethod.Post, new { @id = "ChallengeResult" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.CheckTypeId)
    @Html.HiddenFor(model => model.SBI)
    @Html.HiddenFor(model => model.FRN)
    @Html.HiddenFor(model => model.BACheckTypeId)
    @Html.HiddenFor(model => model.BusinessName)
    @Html.HiddenFor(model => model.PersonName)
    @Html.HiddenFor(model => model.ManagerName)
    @Html.HiddenFor(model => model.DateQCCreated)
    @Html.HiddenFor(model => model.QCCompletedByName)
    @Html.HiddenFor(model => model.DateQCCompleted)

    <div class="form-horizontal">
        <div class="panel panel-primary">
            <div class="panel-heading">Bank Account - QC Result (Challenge)</div>
            <div class="panel-body">

                <div class="form-group">
                    <span class="control-label col-md-2"><b>QC Result</b></span>
                    <div class="col-md-10">
                        @Html.DropDownList("Result", null, new { @class = "form-control" })
                    </div>
                </div>

                <div class="form-group">
                    <span class="control-label col-md-2">@Html.LabelFor(model => model.FailReason.Text, new { @class = "form-label" })</span>
                    <div class="col-md-10">
                        @Html.DropDownList("FailReasonId", null, "", new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.FailReasonId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <span class="control-label col-md-2" style="padding-left: 30px">@Html.LabelFor(model => model.CoachingPoint, new { @class = "form-label" })</span>
                    <div class="col=md-10">
                        <div class="multiple-choice">@Html.RadioButtonFor(model => model.CoachingPoint, "True")@Html.Label("Yes")</div>
                        <div class="multiple-choice">@Html.RadioButtonFor(model => model.CoachingPoint, "False")@Html.Label("No")</div>
                    </div>
                </div>

                <div class="form-group">
                    <span class="control-label col-md-2" style="padding-left: 30px">@Html.LabelFor(model => model.ReCheckRequired, new { @class = "form-label" })</span>
                    <div class="col=md-10">
                        <div class="multiple-choice">@Html.RadioButtonFor(model => model.ReCheckRequired, "True", new { @name = "ReCheckFailTrue" })@Html.Label("Yes")</div>
                        <div class="multiple-choice">@Html.RadioButtonFor(model => model.ReCheckRequired, "False", new { @name = "ReCheckFailTrue" })@Html.Label("No")</div>
                    </div>
                </div>

                <div class="form-group">
                    <span class="control-label col-md-2">@Html.LabelFor(model => model.Comments, new { @class = "form-label" })</span>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.Comments, new { @class = "form-control", rows = 6 })
                        @Html.ValidationMessageFor(model => model.Comments, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="form-group">
        <input type="submit" value="Save and Submit Quality Check Changes" class="button" />
    </div>


}
<div class="form-group">
    <a href="@Url.Action("ChallengeQuestions","BankAccount", new { CheckId = Model.CheckId })" class="link-back">Back</a>
</div>
