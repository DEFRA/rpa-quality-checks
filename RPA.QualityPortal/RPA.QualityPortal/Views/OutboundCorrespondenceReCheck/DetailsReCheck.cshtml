@model RPA.QualityPortal.ViewModels.DetailsReCheck

@{
    ViewBag.Title = "DetailsReCheck";
    ViewBag.CheckType = "Outbound";
}
    <br />
<div class="form-horizontal">
    <div class="panel panel-primary">
        <div class="panel-heading">Outbound Correspondence - General Details</div>
        <div class="panel-body">
            @Html.HiddenFor(model => model.OutboundCorrespondenceReCheck.CheckId)
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.Scheme.Text)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.Scheme.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.BusinessArea.Text)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.BusinessArea.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.CorrespondenceType.Text)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.CorrespondenceType.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.TemplateReference)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.TemplateReference, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.UniqueId)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.UniqueIdentifierPrefix.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.UniqueId, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.CRMRef)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.CRMRefPrefix.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.CRMRef, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.SBI)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.SBI, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.PersonName)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.PersonName, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.ManagerName)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.ManagerName, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.HEO)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.HEO, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.SEO)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.SEO, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.QCCompletedByName)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.QCCompletedByName, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    Date Check Completed
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.DateQCCompleted, "{0:dd/MM/yyyy}", htmlAttributes: new { @class = "form-control", @readonly = "readonly", @disabled = "disabled", @type = "datetime", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
        </div>
    </div>
    @*Questions*@
    <div class="panel panel-primary">
        <div class="panel-heading">Outbound Correspondence - QC Questions</div>
        <div class="panel-body">

            <table class="table">
                <tr>
                    <th>

                    </th>
                    <th>
                        Question
                    </th>
                    <th style="text-align:center">
                        Answer
                    </th>
                    <th style="text-align:center">
                        Recheck Answer
                    </th>
                </tr>

                @for (int i = 0; i < Model.Answers.Count(); i++)
                {
                    int order;

                    { order = i + 1; }

                    <tr>
                        <td>
                            @order
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => modelItem.Answers[i].Question.Text)
                        </td>
                        <td>
                            @Html.TextBoxFor(modelItem => modelItem.Answers[i].Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:100px; font-size:15px;" })
                        </td>
                        <td>
                            @Html.TextBoxFor(modelItem => modelItem.ReCheckAnswers[i].Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:100px; font-size:15px;" })
                        </td>
                    </tr>

                }

            </table>
        </div>
    </div>
    @*Result*@
    <div class="panel panel-primary">
        <div class="panel-heading">Outbound Correspondence - QC Result</div>
        <div class="panel-body">
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.QCResult)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.QCResult, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.FailReason.Text)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondence.FailReason.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.ReCheckRequired)
                </span>
                <div class="col-md-10" style="margin-top:10px">
                    @Html.DisplayFor(model => model.OutboundCorrespondence.ReCheckRequired)
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.InitialReCheckDecision)
                </span>
                <div class="col-md-10" style="margin-top:10px">
                    @Html.DisplayFor(model => model.OutboundCorrespondence.InitialReCheckDecision)
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.ExcludeQCResult)
                </span>
                <div class="col-md-10" style="margin-top:10px">
                    @Html.DisplayFor(model => model.OutboundCorrespondence.ExcludeQCResult)
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondence.Comments)
                </span>
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.OutboundCorrespondence.Comments, new { @readonly = "readonly", @class = "form-control", @rows = 6 })
                </div>
            </div>
        </div>
    </div>

    @if (Model.Challenge == true)
    {
        <div>
            @{
                Html.RenderAction("_ChallengeView", "OutboundCorrespondence", new { CheckId = Model.OutboundCorrespondence.CheckId });
            }
        </div>
    }

    @*ReCheck Results*@
    <div class="panel panel-primary">
        <div class="panel-heading">Outbound Correspondence - QC Recheck Result</div>
        <div class="panel-body">
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.ReCheckResult)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.ReCheckResult, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondenceReCheck.ReCheckCompletedBy)
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondenceReCheck.ReCheckCompletedBy, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    Date ReCheck Completed
                </span>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.OutboundCorrespondenceReCheck.DateQCCompleted, "{0:dd/MM/yyyy}", htmlAttributes: new { @class = "form-control", @readonly = "readonly", @disabled = "disabled", @type = "datetime", @style = "width:300px; font-size:15px;" })
                </div>
            </div>
            <div class="form-group">
                <span class="control-label col-md-2">
                    @Html.DisplayNameFor(model => model.OutboundCorrespondenceReCheck.ReCheckComments)
                </span>
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.OutboundCorrespondenceReCheck.ReCheckComments, new { @readonly = "readonly", @class = "form-control", @rows = 6 })
                </div>
            </div>
        </div>
    </div>

    @*Amendment Reason*@
    @if (Model.CheckAmendmentReason != null)
    {
        <div class="panel panel-primary">
            <div class="panel-heading">Amendment Reason</div>
            <div class="panel-body">

                <div class="form-group">
                    <span class="control-label col-md-2">
                        @Html.DisplayNameFor(model => model.CheckAmendmentReason.AmendmentReason.Text)
                    </span>
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.CheckAmendmentReason.AmendmentReason.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                    </div>
                </div>

                <div class="form-group">
                    <span class="control-label col-md-2">
                        @Html.DisplayNameFor(model => model.CheckAmendmentReason.AmendmentReasonComments)
                    </span>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.CheckAmendmentReason.AmendmentReasonComments, new { @readonly = "readonly", @class = "form-control", @rows = 6 })
                    </div>
                </div>

            </div>
        </div>
    }

    @*Amendment Reason*@
    @if (Model.ReCheckAmendmentReason != null)
    {
        <div class="panel panel-primary">
            <div class="panel-heading">Recheck Amendment Reason</div>
            <div class="panel-body">

                <div class="form-group">
                    <span class="control-label col-md-2">
                        @Html.DisplayNameFor(model => model.ReCheckAmendmentReason.AmendmentReason.Text)
                    </span>
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.ReCheckAmendmentReason.AmendmentReason.Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:300px; font-size:15px;" })
                    </div>
                </div>

                <div class="form-group">
                    <span class="control-label col-md-2">
                        @Html.DisplayNameFor(model => model.ReCheckAmendmentReason.AmendmentReasonComments)
                    </span>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.ReCheckAmendmentReason.AmendmentReasonComments, new { @readonly = "readonly", @class = "form-control", @rows = 6 })
                    </div>
                </div>

            </div>
        </div>
    }
</div>
<p>

    @Html.ActionLink("Back to Overview", "Index", controllerName: "OutboundCorrespondence") |
    @if (User.IsInRole("Quality Checks: OC Admin"))
    {
        @Html.ActionLink("Edit Check", "EditGeneral", "OutboundCorrespondence", new { CheckId = Model.OutboundCorrespondence.CheckId }, null) <text> | </text>
        @Html.ActionLink("Edit Recheck", "EditReCheckQuestions", new { ReCheckId = Model.OutboundCorrespondenceReCheck.CheckId }) <text> | </text>
    }

    @if (ViewBag.ReCheckCount > 1)
    {
        @Html.ActionLink("View All Rechecks", "DetailsReChecks", new { CheckId = Model.OutboundCorrespondence.CheckId }) <text>|</text>
    }

    @if (User.IsInRole("Quality Checks: OC Admin"))
    {
        @Html.ActionLink("Delete", "DeleteView", "OutboundCorrespondence", new { CheckId = Model.OutboundCorrespondence.CheckId }, null) <text> | </text>
        @Html.ActionLink("Delete Recheck", "DeleteReCheckView", new { CheckId = Model.OutboundCorrespondence.CheckId })
    }

</p>
