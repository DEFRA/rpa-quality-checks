    @*Questions*@
    <div class="panel panel-primary">
        <div class="panel-heading">Correspondence ReCheck Response</div>
        <div class="panel-body">

            <table class="table">
                <tr>
                    <th>

                    </th>
                    <th>
                        Question
                    </th>
                    <th style="text-align:center">
                        Answer
                    </th>
                    <th style="text-align:center">
                        First ReCheck Answer
                    </th>
                    <th style="text-align:center">
                        Second ReCheck Answer
                    </th>
                    @if (Model.ThirdReCheckAnswers.Count > 0)
                    {
                        <th style="text-align:center">
                            Third ReCheck Answer
                        </th>
                    }
                </tr>

                @for (int i = 0; i < Model.Answers.Count(); i++)
                {
                    int order;

                    { order = i + 1; }

                    <tr>
                        <td>
                            @order
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => modelItem.Answers[i].Question.Text)
                        </td>
                        <td>
                            @Html.TextBoxFor(modelItem => modelItem.Answers[i].Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:100px; font-size:15px;" })
                        </td>
                        <td>
                            @Html.TextBoxFor(modelItem => modelItem.FirstReCheckAnswers[i].Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:100px; font-size:15px;" })
                        </td>
                        <td>
                            @Html.TextBoxFor(modelItem => modelItem.SecondReCheckAnswers[i].Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:100px; font-size:15px;" })
                        </td>
                        @if (Model.ThirdReCheckAnswers.Count > 0)
                        {
                            <td>
                                @Html.TextBoxFor(modelItem => modelItem.ThirdReCheckAnswers[i].Text, "", new { @readonly = "readonly", @class = "form-control", @style = "width:100px; font-size:15px;" })
                            </td>
                        }
                    </tr>

                }

            </table>
        </div>
    </div>

