<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>RPA.QualityPortal</RootNamespace>
    <AssemblyName>RPA.QualityPortal</AssemblyName>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.5" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="EntityFramework" Version="6.5.2" />
    <PackageReference Include="EPPlus" Version="4.5.3.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <!-- Pinned above the vulnerable version EF6/System.Data.SqlClient would otherwise pull in transitively (AppCAT Security.0103) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Replaces direct System.Data.SqlClient usage in AccessService/IdtRoleClaimsTransformation (AppCAT Database.0003) -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="X.PagedList.Mvc.Core" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Work in progress that was on disk but never part of the original project -->
    <Compile Remove="Controllers\OutboundCorrespondenceReChecksController.cs" />
    <Compile Remove="Controllers\OutboundCorrespondence\OutboundCorrespondenceAccreditationController.cs" />
    <Compile Remove="Migrations\202002051224141_accreditation.cs" />
    <Compile Remove="Migrations\202002051224141_accreditation.designer.cs" />
    <EmbeddedResource Remove="Migrations\202002051224141_accreditation.resx" />
    <EmbeddedResource Update="Migrations\*.resx">
      <DependentUpon>%(Filename).cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Files\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
